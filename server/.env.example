PORT=5000
JWT_SECRET=replace_this_with_a_64_char_random_string_use_openssl_rand_hex_32
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# F3: Email notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gbmarket.pk
ADMIN_EMAIL=

# Optional: absolute path to the SQLite database file.
# Leave blank for local development (defaults to server/db/gbmarket.db).
# In production, set this to a path on a persistent disk/volume (e.g. /data/gbmarket.db on Render's persistent disk),
# otherwise your database may be reset on every redeploy.
DB_PATH=

# Cloudinary Configuration
# Get these values from your Cloudinary dashboard at cloudinary.com after signing up (free tier). Leave blank to use local disk storage for development instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=